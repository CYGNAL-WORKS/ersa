  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "gen": "node scripts/gen-types.mjs && node scripts/gen-tokens.mjs && node scripts/gen-catalog.mjs",
    "gen:check": "node scripts/gen-types.mjs --check && node scripts/gen-tokens.mjs --check && node scripts/gen-catalog.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:screenshots": "playwright test",
